SPREADSHEET_ID=your_spreadsheet_id_here
REFRESH_TOKEN_SECRET=change_me_to_a_long_random_secret
# For local OAuth dev; leave blank to use Application Default Credentials (ADC)
GOOGLE_OAUTH_TOKEN_FILE=token.json
GOOGLE_OAUTH_CREDENTIALS_FILE=credentials.json
# Cache TTL in seconds (default 6 hours)
CACHE_TTL_SECONDS=21600
